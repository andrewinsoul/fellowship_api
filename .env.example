# Local development defaults are configured in config/dev.exs.
# Production runtime requires DATABASE_URL and SECRET_KEY_BASE.
DATABASE_URL=ecto://postgres:postgres@localhost/fellowship_api_prod
SECRET_KEY_BASE=replace-with-a-long-random-secret
PORT=4000
POOL_SIZE=10
CHECK_IN_QR_TOKEN=XXXXXX
DATABASE_SSL=false
# Comma-separated browser origins when deploying the PWA separately.
CHECK_ORIGIN=https://app.example.com
